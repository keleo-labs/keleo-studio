{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/library/layout,_N_T_/library/browse/layout,_N_T_/library/browse/page,_N_T_/library/browse"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/library/browse/__PAGE__",
    "/library/browse",
    "/library",
    "/_index",
    "/_head"
  ]
}