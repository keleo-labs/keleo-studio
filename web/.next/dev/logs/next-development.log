yName\":\"Management\",\"description\":\"Extends to new contexts\",\"level\":5,\"name\":\"Innovating\"}],\"name\":\"Management\"},{\"description\":\"The ability to design, implement, and automate security policies, access controls, and compliance checks within the platform.\",\"levels\":[{\"competencyName\":\"Platform Security And Compliance Enforcement\",\"description\":\"Understands basic security principles and compliance requirements.\",\"level\":1,\"name\":\"Basic\"},{\"competencyName\":\"Platform Security And Compliance Enforcement\",\"description\":\"Can configure basic security settings and access controls based on documented procedures.\",\"level\":2,\"name\":\"Applies\"},{\"competencyName\":\"Platform Security And Compliance Enforcement\",\"description\":\"Can independently design and implement comprehensive security architectures and automate compliance auditing.\",\"level\":3,\"name\":\"Masters\"},{\"competencyName\":\"Platform Security And Compliance Enforcement\",\"description\":\"Can adapt security strategies to address novel threats and complex, multi-cloud environments.\",\"level\":4,\"name\":\"Adapts\"},{\"competencyName\":\"Platform Security And Compliance Enforcement\",\"description\":\"Develops new paradigms for platform security and proactive threat hunting.\",\"level\":5,\"name\":\"Innovating\"}],\"name\":\"Platform Security And Compliance Enforcement\"},{\"description\":\"The ability to align platform capabilities and roadmap with broader business goals, economic models, and enterprise architecture.\",\"levels\":[{\"competencyName\":\"Platform Strategic Alignment\",\"description\":\"Understands the high-level business drivers for the platform.\",\"level\":1,\"name\":\"Basic\"},{\"competencyName\":\"Platform Strategic Alignment\",\"description\":\"Can articulate how specific platform features support identified business opportunities.\",\"level\":2,\"name\":\"Applies\"},{\"competencyName\":\"Platform Strategic Alignment\",\"description\":\"Can