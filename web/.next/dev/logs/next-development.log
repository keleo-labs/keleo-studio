iability\",\"Management\"]},{\"contributesTo\":[{\"alphaName\":\"Platform Governance\",\"stateName\":\"Documented\"},{\"alphaName\":\"Platform Governance\",\"stateName\":\"Audited\"}],\"description\":\"Translate manual governance rules into automated, machine-readable policies that execute within deployment pipelines without impeding velocity.\",\"focusName\":\"Endeavor\",\"name\":\"Implement Policy-as-Code\",\"requiredCompetencies\":[\"Platform Security And Compliance Enforcement\",\"Engineering\"]},{\"contributesTo\":[{\"alphaName\":\"Organizational Change\",\"stateName\":\"Strategized\"},{\"alphaName\":\"Organizational Change\",\"stateName\":\"Enabled\"},{\"alphaName\":\"Organizational Change\",\"stateName\":\"Embedded\"}],\"description\":\"Execute formal change management programs, upskill engineering talent, address behavioral resistance, and facilitate the shift to product-driven platform engineering.\",\"focusName\":\"Endeavor\",\"name\":\"Drive Cultural Transformation\",\"requiredCompetencies\":[\"Leadership\",\"Management\"]},{\"contributesTo\":[{\"alphaName\":\"Work\",\"stateName\":\"Closed\"}],\"description\":\"Stop the work and close out the endeavor.\",\"focusName\":\"Endeavor\",\"name\":\"Stop The Work\",\"requiredCompetencies\":[\"Management\"]}],\"alphas\":[{\"description\":\"The foundational business drivers dictating the platform transformation.\",\"focusName\":\"Value\",\"name\":\"Opportunity\",\"states\":[{\"checklist\":[],\"description\":\"The desire to adopt a platform is identified.\",\"name\":\"Initiated\",\"seq\":1},{\"checklist\":[],\"description\":\"The value and parameters of the platform are quantified.\",\"name\":\"Determined\",\"seq\":2},{\"checklist\":[],\"description\":\"The platform's value is accepted by sponsors.\",\"name\":\"Value Established\",\"seq\":3},{\"checklist\":[],\"description\":\"The business case demonstrates a viable return.\",\"name\":\"Viable\",\"seq\":4},{\"checklist\":[],\"description\":\"The opportunity is actively being addressed by the platform.\",\"name\":\"Addressed\",\"seq\":5},{\"checklist\":[],\"description\":\"The expected benefits are being consistently realized.\",\"name\":\"Benefit Accrued\",\"seq\":6}]},{\"description\":\"The financial and outcome-based justification and accounting for the platform.\",\"focusName\":\"Value\",\"name\":\"Platform Value And Economics\",\"states\":[{\"checklist\":[],\"description\":\"Financial needs and potential values are recognized.\",\"name\":\"Modeled\",\"seq\":1},{\"checklist\":[],\"description\":\"Costs and benefits are logically modeled.\",\"name\":\"Allocated\",\"seq\":2},{\"checklist\":[],\"description\":\"The economic model is approved.\",\"name\":\"Sustained\",\"seq\":3}]},{\"description\":\"The individuals, groups, or organizations affected by, or able to affect, the platform.\",\"focusName\":\"Value\",\"name\":\"Stakeholders\",\"states\":[{\"checklist\":[],\"description\":\"Key stakeholders are identified.\",\"name\":\"Recognized\",\"seq\":1},{\"checklist\":[],\"description\":\"Stakeholder representatives are designated.\",\"name\":\"Represented\",\"seq\":2},{\"checklist\":[],\"description\":\"Stakeholders actively participate.\",\"name\":\"Involved\",\"seq\":3},{\"checklist\":[],\"description\":\"Stakeholder expectations are aligned.\",\"name\":\"In Agreement\",\"seq\":4},{\"checklist\":[],\"description\":\"Stakeholders approve deployment.\",\"name\":\"Satisfied for Deployment\",\"seq\":5},{\"checklist\":[],\"description\":\"Stakeholders are satisfied with the operational platform.\",\"name\":\"Satisfied in Use\",\"seq\":6}]},{\"description\":\"The capabilities, features, and constraints the platform must satisfy.\",\"focusName\":\"Solution\",\"name\":\"Requirements\",\"states\":[{\"checklist\":[],\"description\":\"The need for a specific asset is identified.\",\"name\":\"Conceived\",\"seq\":1},{\"checklist\":[],\"description\":\"The scope of the requirements is defined.\",\"name\":\"Bounded\",\"seq\":2},{\"checklist