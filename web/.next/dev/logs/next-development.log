":\"Lifecycle\"}],\"patterns\":[{\"description\":\"The end-to-end orchestration of planning, installing, securing, and scaling the platform ecosystem.\",\"name\":\"AAP 2.6 Enterprise Adoption Lifecycle\",\"narrativeTypeName\":\"Lifecycle\",\"narratives\":[{\"description\":\"The sequential approach to deploying AAP 2.6 effectively.\",\"name\":\"Adoption Lifecycle Context\",\"narrativeContexts\":\"[Array]\",\"narrativeName\":\"Orchestrating the Entire Rollout\",\"narrativeTypeName\":\"Lifecycle\"}],\"patternViews\":[{\"alphaStates\":\"[Array]\",\"description\":\"Securing enterprise subscriptions, evaluating basic workloads, and establishing a baseline understanding of capability needs.\",\"name\":\"Prerequisites Phase\",\"seq\":0},{\"alphaStates\":\"[Array]\",\"description\":\"Finalizing exhaustive system blueprints, provisioning the base RHEL host nodes, and finalizing the exact configurations to be injected.\",\"name\":\"Architecture and Preparation Phase\",\"seq\":1},{\"alphaStates\":\"[Array]\",\"description\":\"Executing the configuration-as-code installer playbooks and rigorously validating that core rootless container services are active.\",\"name\":\"Container Deployment Phase\",\"seq\":2},{\"alphaStates\":\"[Array]\",\"description\":\"Hardening access controls via the Gateway, integrating SSO, and deploying the initial layers of the automation mesh.\",\"name\":\"Governance and Day-2 Operations Phase\",\"seq\":3},{\"alphaStates\":\"[Array]\",\"description\":\"Reaching peak maturity by fully automating governance and verifying edge execution resilience.\",\"name\":\"Enterprise Scale Phase\",\"seq\":4}]}],\"personaGroups\":[],\"personas\":[],\"workProducts\":[]}"}
